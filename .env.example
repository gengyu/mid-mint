# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database Configuration (TypeORM + SQLite)
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/mid-mint.db

# For PostgreSQL (production):
# DATABASE_TYPE=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your_password
# DATABASE_NAME=mid_mint

# Redis Configuration (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# LLM Configuration
# Choose one provider: openai | ollama | lmstudio
LLM_PROVIDER=ollama

# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# Ollama Configuration (local)
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_MODEL=llama3.1:8b

# LM Studio Configuration (local)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# LLM Settings
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=30000

# Storage Configuration
UPLOAD_DIR=./tmp/uploads
OUTPUT_DIR=./outputs
PROJECTS_DIR=./data/projects

# File Upload Limits
MAX_FILE_SIZE=10485760  # 10MB in bytes

# Job Queue Configuration
JOB_CONCURRENCY=5
JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY=5000

# Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# CORS Configuration
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_TTL=60  # seconds
RATE_LIMIT_MAX=100  # requests per TTL
